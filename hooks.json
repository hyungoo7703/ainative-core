{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/remember-recall.sh\" # [ainative-core] recall inbox items"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "grep -q 'git commit' && echo '[ainative-core] Commit done. Run /review to review the changes.'; exit 0"
          }
        ]
      }
    ]
  }
}
