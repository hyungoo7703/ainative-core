{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/remember-recall.sh\" # [ainative-core] recall inbox items"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/review-reminder.sh\" # [ainative-core] review reminder after git commit"
          }
        ]
      }
    ]
  }
}
